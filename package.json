{
  "name": "evil-house-cursed-memories",
  "version": "1.0.0",
  "description": "THE EVIL HOUSE — CURSED MEMORIES",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.evilhouse.cursedmemories",
    "productName": "The Evil House",
    "files": ["main.js", "game/**/*"],
    "win": { "target": "portable" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
